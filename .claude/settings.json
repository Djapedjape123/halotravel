{
  "enabledPlugins": {
    "supabase@anthropic-plugin-directory": true,
    "securitymaxxing@anthropic-plugin-directory": true
  },
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./.env.production)",
      "Bash(npx supabase db push:*)",
      "Bash(npx supabase db reset --linked:*)",
      "Bash(vercel --prod:*)",
      "Bash(npx vercel --prod:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(npx supabase link:*)"
    ]
  }
}
